<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chat_analysis_wizard_form" model="ir.ui.view">
        <field name="name">chat.analysis.wizard.form</field>
        <field name="model">chat.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Chat Analysis">
                <sheet>
                    <div class="oe_title">
                        <h1>Analyze Chat Conversation</h1>
                    </div>

                    <group name="main" string="Analysis Parameters">
                        <field name="chat_id" required="1" options="{'no_create': True}"/>
                        <field name="report_type" widget="radio" required="1"/>

                        <separator string="Date Range" colspan="2"/>
                        <field name="date_start" required="1"/>
                        <field name="date_end" required="1"/>

                        <field name="instruction"
                               placeholder="Enter the compliance instruction/requirements..."
                               invisible="report_type != 'compliance'"
                               required="report_type == 'compliance'"
                               colspan="2"/>
                        <field name="instruction_domain"
                               placeholder="E.g., Customer Support, Sales, Internal Communication"
                               invisible="report_type != 'compliance'"
                               colspan="2"/>
                    </group>

                    <footer>
                        <button name="action_analyze" type="object" string="Start Analysis" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chat_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Analyze Chat</field>
        <field name="res_model">chat.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_chat_sync_batch_wizard_form" model="ir.ui.view">
        <field name="name">chat.sync.batch.wizard.form</field>
        <field name="model">chat.sync.batch.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Batch Synchronization</h1>
                    </div>
                    <group>
                        <field name="sync_type" widget="radio"/>
                    </group>
                    <footer>
                        <button name="action_sync" type="object" string="Sync Now" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chat_sync_batch_wizard" model="ir.actions.act_window">
        <field name="name">Batch Sync</field>
        <field name="res_model">chat.sync.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>