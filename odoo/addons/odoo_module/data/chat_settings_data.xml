<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Установка параметров API по умолчанию -->
        <record id="default_api_settings" model="ir.config_parameter">
            <field name="key">chat_analysis.api_url</field>
            <field name="value">http://chat_api:8000</field>
        </record>
        <record id="default_api_key" model="ir.config_parameter">
            <field name="key">chat_analysis.api_key</field>
            <field name="value">odoo_api_key_1</field>
        </record>
    </data>
</odoo>