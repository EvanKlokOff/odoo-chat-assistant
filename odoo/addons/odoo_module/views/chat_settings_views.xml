<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chat_analysis_settings_form" model="ir.ui.view">
        <field name="name">chat.analysis.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Chat Analysis" string="Chat Analysis" id="chat_analysis_settings">
                    <h2>Chat Analysis</h2>

                    <!-- API URL -->
                    <setting string="API URL" help="URL of the Chat Analysis API service">
                        <field name="chat_analysis_api_url" placeholder="http://chat_api:8000"/>
                    </setting>

                    <!-- API Key -->
                    <setting string="API Key" help="API key for authentication with the chat analysis service">
                        <field name="chat_analysis_api_key" password="True"/>
                    </setting>

                    <!-- Auto Sync -->
                    <setting string="Auto Sync" help="Automatically sync chats and messages">
                        <field name="chat_analysis_auto_sync"/>
                    </setting>

                    <!-- Sync Interval -->
                    <setting string="Sync Interval (hours)" help="How often to sync data from the API">
                        <field name="chat_analysis_sync_interval"/>
                    </setting>

                    <!-- Test Connection Button -->
                    <setting string="API Connection Test" help="Click to test connection to Chat Analysis API">
                        <button name="action_test_api_connection" type="object" string="Test Connection" class="btn-primary"/>
                    </setting>

                </div>
            </xpath>
        </field>
    </record>
</odoo>