<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chat_analysis_settings_form" model="ir.ui.view">
        <field name="name">chat.analysis.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Добавляем настройки в конец формы -->
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Chat Analysis" string="Chat Analysis" id="chat_analysis_settings">
                    <h2>Chat Analysis</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="chat_analysis_api_url" placeholder="http://chat_api:8000"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="chat_analysis_api_url" string="API URL"/>
                                <div class="text-muted">URL of the Chat Analysis API service</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="chat_analysis_api_key" password="True"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="chat_analysis_api_key" string="API Key"/>
                                <div class="text-muted">API key for authentication with the chat analysis service</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="chat_analysis_auto_sync"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="chat_analysis_auto_sync" string="Auto Sync"/>
                                <div class="text-muted">Automatically sync chats and messages</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="chat_analysis_sync_interval"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="chat_analysis_sync_interval" string="Sync Interval (hours)"/>
                                <div class="text-muted">How often to sync data from the API</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <button name="action_test_api_connection" type="object" string="Test Connection" class="btn-primary"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">API Connection Test</span>
                                <div class="text-muted">Click to test connection to Chat Analysis API</div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>