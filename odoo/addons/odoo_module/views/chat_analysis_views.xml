<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- User List View -->
    <record id="view_chat_analysis_user_list" model="ir.ui.view">
        <field name="name">chat.analysis.user.list</field>
        <field name="model">chat.analysis.user</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_name"/>
                <field name="telegram_id"/>
                <field name="message_count" widget="integer"/>
                <field name="chat_count" widget="integer"/>
                <field name="last_active"/>
            </list>
        </field>
    </record>

    <!-- User Form View -->
    <record id="view_chat_analysis_user_form" model="ir.ui.view">
        <field name="name">chat.analysis.user.form</field>
        <field name="model">chat.analysis.user</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box">
                        <button name="action_view_messages" type="object" class="oe_stat_button" icon="fa-comments">
                            <div class="o_stat_info">
                                <field name="message_count" widget="statinfo"/>
                                <span class="o_stat_text">Messages</span>
                            </div>
                        </button>
                        <button name="action_sync_user_data" type="object" class="oe_stat_button" icon="fa-refresh">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sync User</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="user_name"/>
                            <field name="telegram_id"/>
                        </group>
                        <group>
                            <field name="external_id"/>
                            <field name="last_active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chats">
                            <field name="chat_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="last_used"/>
                                    <field name="message_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reports">
                            <field name="report_ids">
                                <list>
                                    <field name="display_name"/>
                                    <field name="analysis_type" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Chat List View -->
    <record id="view_chat_analysis_chat_list" model="ir.ui.view">
        <field name="name">chat.analysis.chat.list</field>
        <field name="model">chat.analysis.chat</field>
        <field name="arch" type="xml">
            <list>
                <field name="title"/>
                <field name="last_used"/>
                <field name="message_count" widget="integer"/>
                <field name="selected" widget="boolean_toggle"/>
                <field name="sync_enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Chat Form View -->
    <record id="view_chat_analysis_chat_form" model="ir.ui.view">
        <field name="name">chat.analysis.chat.form</field>
        <field name="model">chat.analysis.chat</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_messages" type="object" string="Sync Messages" class="btn-primary"/>
                    <button name="action_sync_all_messages" type="object" string="Sync All Pages"
                            class="btn-secondary"/>
                    <button name="action_refresh_stats" type="object" string="Refresh Stats"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_chat_analysis_wizard)d" type="action" class="oe_stat_button"
                                icon="fa-search">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Analyze</span>
                            </div>
                        </button>
                        <button name="action_export_chat_data" type="object" class="oe_stat_button" icon="fa-download">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Export Data</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="external_id"/>
                            <field name="last_used"/>
                            <field name="selected"/>
                        </group>
                        <group>
                            <field name="message_count" widget="statinfo"/>
                            <field name="sync_enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Users">
                            <field name="user_ids">
                                <list>
                                    <field name="user_name"/>
                                    <field name="telegram_id"/>
                                    <field name="message_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reports">
                            <field name="report_ids">
                                <list>
                                    <field name="display_name"/>
                                    <field name="analysis_type" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Report List View -->
    <record id="view_chat_analysis_report_list" model="ir.ui.view">
        <field name="name">chat.analysis.report.list</field>
        <field name="model">chat.analysis.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="chat_id"/>
                <field name="analysis_type" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="compliant" widget="boolean_toggle"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Report Form View -->
    <record id="view_chat_analysis_report_form" model="ir.ui.view">
        <field name="name">chat.analysis.report.form</field>
        <field name="model">chat.analysis.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh_status" type="object" string="Refresh Status"
                            class="btn-info"
                            invisible="state not in ['processing', 'pending']"/>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-warning"
                            invisible="state != 'error'"/>
                    <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_chart" type="object" class="oe_stat_button" icon="fa-line-chart"
                                invisible="state != 'completed'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Analytics</span>
                            </div>
                        </button>
                        <button name="action_export_report" type="object" class="oe_stat_button" icon="fa-download"
                                invisible="state != 'completed'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Export</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="chat_id"/>
                            <field name="analysis_type"/>
                            <field name="user_id"/>
                            <field name="task_id" invisible="not task_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="analysis_duration" widget="float_time" invisible="analysis_duration == 0"/>
                        </group>
                    </group>

                    <group string="Review Results"
                           invisible="analysis_type != 'review' or state != 'completed'">
                        <field name="summary" nolabel="1"/>
                        <field name="sentiment" widget="badge"/>
                        <field name="key_points" nolabel="1"/>
                        <field name="communication_style"/>
                        <field name="recommendations"/>
                        <group>
                            <field name="participant_count"/>
                            <field name="message_count"/>
                        </group>
                    </group>

                    <group string="Compliance Results"
                           invisible="analysis_type != 'compliance' or state != 'completed'">
                        <field name="instruction" nolabel="1" readonly="1"/>
                        <field name="instruction_domain"/>
                        <separator/>
                        <group>
                            <field name="compliant" widget="boolean_toggle"/>
                            <field name="confidence" widget="progressbar"/>
                        </group>
                        <group>
                            <field name="severe_violations" widget="statinfo"/>
                            <field name="minor_violations" widget="statinfo"/>
                        </group>
                        <field name="explanation" nolabel="1"/>
                        <field name="violations" nolabel="1"/>
                        <field name="suggestions" nolabel="1"/>
                    </group>

                    <group string="Error" invisible="state != 'error'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Ticket List View -->
    <record id="view_chat_analysis_ticket_list" model="ir.ui.view">
        <field name="name">chat.analysis.ticket.list</field>
        <field name="model">chat.analysis.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="chat_id"/>
                <field name="priority" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="assigned_to"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Ticket Form View -->
    <record id="view_chat_analysis_ticket_form" model="ir.ui.view">
        <field name="name">chat.analysis.ticket.form</field>
        <field name="model">chat.analysis.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_in_progress" type="object" string="Mark In Progress"
                            class="btn-primary"
                            invisible="[('state', '!=', 'new')]"/>
                    <button name="action_mark_resolved" type="object" string="Resolve"
                            class="btn-success"
                            invisible="[('state', '!=', 'new'), ('state', '!=', 'in_progress')]"/>
                    <button name="action_mark_closed" type="object" string="Close"
                            class="btn-secondary"
                            invisible="[('state', '!=', 'resolved')]"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            class="btn-warning"
                            invisible="[('state', 'in', ['new', 'in_progress'])]"/>
                    <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="chat_id"/>
                            <field name="report_id"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="assigned_to"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Violations">
                            <field name="violations" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Message List View -->
    <record id="view_chat_analysis_message_list" model="ir.ui.view">
        <field name="name">chat.analysis.message.list</field>
        <field name="model">chat.analysis.message</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="sender_name"/>
                <field name="timestamp"/>
                <field name="chat_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <!-- Message Form View -->
    <record id="view_chat_analysis_message_form" model="ir.ui.view">
        <field name="name">chat.analysis.message.form</field>
        <field name="model">chat.analysis.message</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sender_name"/>
                            <field name="user_id"/>
                            <field name="chat_id"/>
                        </group>
                        <group>
                            <field name="timestamp"/>
                            <field name="message_id"/>
                            <field name="external_id"/>
                        </group>
                    </group>
                    <field name="content" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>